{
  "name": "garmin-activities-download",
  // Reuse the project's Dockerfile so the dev environment matches the shipped
  // image (same python:3.14-slim base and non-root appuser). The `dev` stage
  // rather than the default `runtime` one: runtime strips pip out, which
  // postCreateCommand below needs.
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  // Run as the image's existing non-root user. The Dockerfile fixes appuser at
  // UID/GID 1000; on Linux updateRemoteUserUID:true remaps that to the host
  // user when the container is created, avoiding bind-mount permission
  // problems without any build arguments.
  "remoteUser": "appuser",
  "updateRemoteUserUID": true,
  // Mount the repository at its host path instead of at /workspaces/<repo>.
  // Claude Code keys each session transcript on the working directory. A
  // different path in the container therefore hides every session that the
  // host recorded, and `claude --continue` starts from nothing.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind,consistency=cached",
  "workspaceFolder": "${localWorkspaceFolder}",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": { "installZsh": true },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Claude Code ships as an npm package; without a node runtime already
    // present its feature bootstraps Node 18 from NodeSource, so pin LTS here
    // instead. The claude-code feature declares installsAfter node, so the
    // ordering is handled for us.
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    // Installs the `claude` CLI globally and pulls in the anthropic.claude-code
    // VS Code extension via its own feature metadata.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  // Share the whole host home, at the same absolute path it has on the host.
  //
  // Claude Code keeps its state in two places: the ~/.claude directory and the
  // ~/.claude.json file beside it. That file holds the MCP servers, the enabled
  // plugins and the per-project trust state. Claude Code rewrites it with an
  // atomic rename, so a single-file bind mount becomes stale after the first
  // write. A directory mount is the only way to share it, and the only
  // directory that contains it is the host home.
  //
  // The identical path on both sides also makes the absolute paths that the
  // host writes into ~/.claude resolve here. One example is the installLocation
  // of each plugin marketplace in plugins/known_marketplaces.json.
  //
  // This needs a POSIX home directory on the host: WSL, Linux or macOS. The
  // container keeps its own shell configuration, because ${localEnv:HOME} and
  // /home/appuser are different paths.
  "mounts": [
    "source=${localEnv:HOME},target=${localEnv:HOME},type=bind,consistency=cached"
  ],
  "containerEnv": {
    "HOST_HOME": "${localEnv:HOME}"
  },
  // link-claude-home.sh points ~/.claude, ~/.agents and ~/.claude.json of
  // appuser at the host home. The image installs requirements.txt only, so the
  // dev tools (pytest, ruff, ...) come next. --user because appuser cannot
  // write to the system site-packages.
  "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/link-claude-home.sh && pip install --user -r requirements.txt -r requirements-dev.txt",
  // The workspace is not the Dockerfile's /app, so point interactive
  // `python -m src.main` runs at the repository folders.
  "remoteEnv": {
    "OUTPUT_DIR": "${containerWorkspaceFolder}/data",
    "TOKENS_DIR": "${containerWorkspaceFolder}/tokens"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "anthropic.claude-code"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "ruff.lineLength": 120,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        }
      }
    }
  }
}
