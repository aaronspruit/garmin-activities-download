# Comma-separated list of trackers to download from: garmin, wahoo.
# Each tracker keeps its own tokens under TOKENS_DIR and reads its own
# credentials below. If one tracker fails, the others still run.
TRACKERS=garmin

# --- Garmin credentials ---
# Optional once the token store is seeded by `python -m src.setup garmin`.
# Used again only if the saved tokens stop working.
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-password

# --- Wahoo credentials ---
# Register an application at the Wahoo developer portal to get these, then run
# `python -m src.setup wahoo` once. Unlike Garmin, both values are needed on
# EVERY run: the container refreshes the 2-hour access token with them.
# WAHOO_CLIENT_ID=your-client-id
# WAHOO_CLIENT_SECRET=your-client-secret
# Must match the redirect URI registered for the application. Wahoo does not
# accept an http:// URI, so the default is https, and nothing listens there.
# WAHOO_REDIRECT_URI=https://localhost

DAYS_BACK=7
TOKENS_DIR=/app/tokens
OUTPUT_DIR=/app/data
# Where the deduplication markers go. One empty file for each activity file, so
# a downstream system can delete the activity file after import without the
# container downloading it again. Defaults to OUTPUT_DIR/.state, which the same
# volume already persists. Set it only if something reads OUTPUT_DIR recursively
# and must not see the .state folder.
# STATE_DIR=/app/state
# Comma-separated download targets. Each entry is a destination folder and the
# formats it receives: `folder=FORMAT[+FORMAT]`. A bare format is short for a
# folder of the same name, so FIT means FIT=FIT -> data/FIT.
# A destination belongs to whatever consumes it, so it may hold several formats
# and may be several levels deep, e.g.
# DOWNLOAD_TARGETS=FIT, strava-inbox=GPX, GPX/you@example.com=GPX+FIT
# {format} and {tracker} are substituted, e.g. archive/{tracker}=FIT.
# A tracker skips any format it cannot supply -- Wahoo provides FIT only.
DOWNLOAD_TARGETS=FIT

# Per-tracker override. Replaces DOWNLOAD_TARGETS for that tracker only; it does
# not add to it. Asking a tracker here for a format it cannot supply is an error.
# GARMIN_DOWNLOAD_TARGETS=FIT, GPX/you@example.com=GPX
# WAHOO_DOWNLOAD_TARGETS=FIT

# Deprecated predecessor of DOWNLOAD_TARGETS, still honoured. Its entries nest a
# subfolder under the format instead (FIT:archive -> data/FIT/archive). Setting
# it together with DOWNLOAD_TARGETS is an error.
# DOWNLOAD_FORMATS=FIT

# UID/GID the container runs as. Set these to your own `id -u` / `id -g` if you
# are not UID 1000, so files written to ./data and ./tokens stay owned by you.
# Applied at run time -- no rebuild needed.
UID=1000
GID=1000
