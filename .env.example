GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-password
DAYS_BACK=7
GARMINTOKENS=/app/tokens
OUTPUT_DIR=/app/data
# Comma-separated download targets. Each entry is FIT, GPX, or TCX, optionally
# followed by :subfolder to save into a folder nested under the format folder
# (FIT:archive -> data/FIT/archive). The same format may be listed more than once,
# bare and/or with different subfolders, e.g.
# DOWNLOAD_FORMATS=FIT,FIT:strava-inbox,FIT:archive,GPX
DOWNLOAD_FORMATS=FIT

# UID/GID the container runs as. Set these to your own `id -u` / `id -g` if you
# are not UID 1000, so files written to ./data and ./tokens stay owned by you.
# Applied at run time -- no rebuild needed.
UID=1000
GID=1000
